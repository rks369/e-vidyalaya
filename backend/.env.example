PORT=3000

# PostgreSQL. The `platform` schema and one `inst_<id>_<code>` schema per institute live in DB_NAME;
# `npm run migrate` creates and updates them.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-existing-database
DB_SSL=true

# Signs login tokens: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email over SMTP. Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 needs SMTP_SECURE=true.
# MAIL_FROM must be an address your SMTP provider allows you to send from.
# Leave SMTP_HOST empty to skip sending. Reset codes are only delivered by email, so password
# recovery needs these set. Passwords for new institutes and users are only sent by e-mail, so they need these set too.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=you@example.com
MAIL_FROM_NAME=E-Vidyalaya

# Uploaded files are stored here and served from /assets. Defaults shown.
# Uploads land in TEMP_DIR first and move to UPLOAD_DIR once attached to a note.
# UPLOAD_DIR=public/uploads
# TEMP_DIR=public/temp
# TEMP_MAX_AGE_HOURS=24
# MAX_UPLOAD_MB=50
# PUBLIC_BASE_URL=https://api.example.com
