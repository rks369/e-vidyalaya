{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (API)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/server.js",
      "runtimeArgs": ["--env-file=.env"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "User (debug)",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "type": "dart",
      "program": "lib/main_user.dart",
      "args": [
        "--flavor",
        "user",
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "User (release)",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main_user.dart",
      "args": [
        "--flavor",
        "user",
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Admin (debug)",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "type": "dart",
      "program": "lib/main_admin.dart",
      "args": [
        "--flavor",
        "admin",
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Admin (release)",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main_admin.dart",
      "args": [
        "--flavor",
        "admin",
        "--dart-define-from-file=env.json"
      ]
    }
  ]
}
